mixin carousel(id, title, slides, options = {})

  section.carousel-section

    h1.carousel-title= title

    .carousel-container(
      id=id
      data-carousel
      data-autoscroll=options.autoScroll ? 'true' : 'false'
      data-interval=options.interval
      data-indicators=options.indicators ? 'true' : 'false'
      data-variant=options.variant
      data-hover-arrows=options.hoverArrows ? 'true' : 'false'
    )

      if options.arrows || options.hoverArrows
        button.arrow.left(data-prev) &#10094;

      .carousel

        each slide, index in slides
          .slide(class=index === 0 ? 'active' : '')
            img(src=slide.image alt=slide.heading)
            .slide-content
              h2= slide.heading
              p= slide.text

      if options.arrows || options.hoverArrows
        button.arrow.right(data-next) &#10095;
        

      if options.indicators
       .indicators(data-indicators)