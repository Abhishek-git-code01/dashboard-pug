doctype html
html
  head
    title title 

    link(
      rel="stylesheet"
      href="/css/style.css"
    )

  body

    include ../partials/navbar
    include ../mixins/carousel
    +carousel(
      'serviceCarousel',
      'Our Services',
      [
        {
          image: 'images/c1.jpg',
          heading: 'Cloud Services',
          text: 'AWS and Azure solutions.'
        },
        {
          image: 'images/c2.jpg',
          heading: 'Web Development',
          text: 'Full stack scalable apps.'
        },
        {
          image: 'images/c3.jpg',
          heading: 'UI UX Design',
          text: 'Modern responsive design.'
        }
      ],
      {
        autoScroll: false,
        indicators: true,
        arrows: true,
        hoverArrows: false,
        interval: 1500
      }
    )

    script(src="/js/carousel.js")

    include ../mixins/accordion

    +accordion("About Us", [
      {
          title: "Who we are",
          content: "BayOne is a minority-owned Technology and Talent Solutions Partner with a global footprint, headquartered in the San Francisco Bay Area."
      },
      {
         title: "What we do",
         content: "We excel at bridging talent and technology gaps, building strong teams in Cloud Computing, IT Infrastructure, Software Engineering, User Experience Design, and more."
      },
      {
         title: "Our Mission",
         content: "Our commitment to customer success is matched by our passion for championing diversity in tech. We believe in sustainable practices and are dedicated to making a positive impact in communities."
      },
      {
        title: "Why BayOne",
        content: "At BayOne, we’re more than a technology and talent partner—we’re a trusted ally in driving innovation and success."
      }
    ])

    script(src="/js/accordion.js")