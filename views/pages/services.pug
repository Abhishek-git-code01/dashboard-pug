doctype html
html
head
title Services


link(
  rel="stylesheet"
  href="/css/style.css"
)

body
include ../partials/navbar
include ../mixins/carousel

+carousel(
  'heroCarousel',
  'Featured Services',
  [
    {
      image: 'images/cloud1.jpg',
      heading: 'Cloud Services',
      text: 'AWS and Azure cloud infrastructure solutions.'
    },
    {
      image: 'images/cloud2.jpg',
      heading: 'Cyber Security',
      text: 'Enterprise-grade security and monitoring.'
    },
    {
      image: 'images/cloud3.jpg',
      heading: 'DevOps',
      text: 'CI/CD automation and scalable deployment.'
    }
  ],
  {
    
    indicators: true,
    arrows: true,
    hoverArrows: true,
    interval: 1500
  }
)

+carousel(
  'webCarousel',
  'Web Development',
  [
    {
      image: 'images/web1.jpg',
      heading: 'Frontend Development',
      text: 'React, Vue and responsive UI applications.'
    },
    {
      image: 'images/web2.jpg',
      heading: 'Backend APIs',
      text: 'Scalable Node.js and Express backends.'
    },
    {
      image: 'images/web3.jpg',
      heading: 'Database Design',
      text: 'MongoDB and SQL database architecture.'
    }
  ],
  {
    autoScroll: true,
    indicators: true,
    arrows: false,
    hoverArrows: true,
    interval: 1000
  }
)

+carousel(
  'designCarousel',
  'UI UX Design',
  [
    {
      image: 'images/uiux1.jpg',
      heading: 'UI Design',
      text: 'Modern clean and responsive interfaces.'
    },
    {
      image: 'images/uiux2.jpg',
      heading: 'UX Research',
      text: 'User-focused product experience design.'
    },
    {
      image: 'images/uiux3.jpg',
      heading: 'Mobile Design',
      text: 'Beautiful Android and iOS app interfaces.'
    }
  ],
  {
    autoScroll: false,
    indicators: false,
    arrows: true,
    hoverArrows:false,
    interval: 1500
  }
)

script(src="/js/carousel.js")

