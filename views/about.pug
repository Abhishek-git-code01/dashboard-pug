doctype html
html
  head
    title= title

    link(
      rel="stylesheet"
      href="/css/style.css"
    )

  body

    
    include partials/navbar

    



    section.carousel-section

      h1.carousel-title Bayone Team Showcase

      .carousel-container

        button.arrow.left &#10094;

        .carousel

          .slide.active
            img(
              src="c1.jpg"
              alt="slide1"
            )
            .slide-content
              h2 Bayone Innovation
              p Building scalable and modern web solutions for developers worldwide.

          .slide
            img(
              src="c2.jpg"
              alt="slide2"
            )
            .slide-content
              h2 Creative Development
              p BayOne focuses on modern UI/UX and high performance applications.

          .slide
            img(
              src="c3.jpg"
              alt="slide3"
            )
            .slide-content
              h2 Future Technology
              p Empowering developers with cutting-edge technologies and learning.

        button.arrow.right &#10095;

    



    script.
      const slides = document.querySelectorAll('.slide');
      const nextBtn = document.querySelector('.right');
      const prevBtn = document.querySelector('.left');

      let current = 0;

      function showSlide(index) {
        slides.forEach(slide => slide.classList.remove('active'));
        slides[index].classList.add('active');
      }

      nextBtn.addEventListener('click', () => {
        current++;
        if (current >= slides.length) current = 0;
        showSlide(current);
      });

      prevBtn.addEventListener('click', () => {
        current--;
        if (current < 0) current = slides.length - 1;
        showSlide(current);
      });

    



    section.accordion-section

      h1 About Us

      .accordion

        .accordion-item
          .accordion-header(onclick="toggleAccordion(this)")
            | Who we are
            span +

          .accordion-body
            p
              | BayOne is a minority-owned Technology and Talent Solutions Partner with a global footprint, headquartered in the San Francisco Bay Area.

        .accordion-item
          .accordion-header(onclick="toggleAccordion(this)")
            | What we do
            span +

          .accordion-body
            p
              | We excel at bridging talent and technology gaps, building strong teams in Cloud Computing, IT Infrastructure, Software Engineering, User Experience Design, and more.

        .accordion-item
          .accordion-header(onclick="toggleAccordion(this)")
            | Our Mission
            span +

          .accordion-body
            p
              | Our commitment to customer success is matched by our passion for championing diversity in tech. We believe in sustainable practices and are dedicated to making a positive impact in communities.

        .accordion-item
          .accordion-header(onclick="toggleAccordion(this)")
            | Why BayOne
            span +

          .accordion-body
            p
              | At BayOne, we’re more than a technology and talent partner—we’re a trusted ally in driving innovation and success.

    


    script.
      function toggleAccordion(el) {
        const item = el.parentElement;
        item.classList.toggle("active");

        const body = item.querySelector(".accordion-body");

        if (item.classList.contains("active")) {
          body.style.maxHeight = body.scrollHeight + "px";
        } else {
          body.style.maxHeight = null;
        }
      }